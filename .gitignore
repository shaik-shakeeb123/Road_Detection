# Environment and secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# Node / frontend
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Runtime data (SQLite DB, uploads, generated outputs)
# data/ is intentionally tracked; the rules below still block stray
# db/log files elsewhere in the repo.
*.sqlite
*.sqlite3
*.db
*.log
logs/

# Model weights and datasets (never commit checkpoints)
weights/
*.pt
*.pth
*.onnx
*.engine
*.h5
*.pkl
datasets/

# Design references (local only, never commit)
design_refernces/
design_references/

# Logs
*.log
logs/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
~$*

# Re-include the project data directory (must come last so it wins
# over the *.log / *.sqlite / *.db / logs/ rules above)
!data/**
