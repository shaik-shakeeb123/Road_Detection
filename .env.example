# RoadVision optional environment variables.
# Copy to .env and adjust only if needed. All values are local and safe defaults.

# Directory where RoadVision stores the SQLite database, uploads, outputs and logs.
# Defaults to <project_root>/data
ROADVISION_DATA_DIR=

# CUDA device index for model inference.
# Defaults to "0"
ROADVISION_DEVICE=0
